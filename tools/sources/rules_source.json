  "rules": [
    {
      "standard": "GB17761-2024",
      "id": "GB17761-2024-max_design_speed",
      "param": "max_design_speed",
      "op": "<=",
      "value": "25",
      "unit": "km/h",
      "clause": "6.1.1.1",
      "clause_status": "verified",
      "source": "openstd_fulltext_2024",
      "status": "verified",
      "verified_on": "2026-10-14",
      "clause_excerpt": "使用电驱动功能行驶时，最高车速不应超过最高设计车速，且最高设计车速不应超过 25 km/h。",
      "notes": "条款号与数值均以正式标准全文（6.1.1.1 车速限值要求 a)）逐条核对；数值与 gov.cn 官方问答一致。"
    },
    {
      "standard": "GB17761-2024",
      "id": "GB17761-2024-over_speed_power_cutoff",
      "param": "over_speed_power_cutoff",
      "op": "==",
      "value": "true",
      "unit": "",
      "clause": "6.1.1.1",
      "clause_status": "verified",
      "source": "openstd_fulltext_2024",
      "status": "verified",
      "verified_on": "2026-10-14",
      "clause_excerpt": "如果车速超过 25 km/h，电动机不应提供动力输出。",
      "notes": "布尔参数承载（具备该功能为 true）；条款号以正式标准全文 6.1.1.1 a)/b) 核对。"
    },
    {
      "standard": "GB17761-2024",
      "id": "GB17761-2024-vehicle_mass-lead-acid",
      "param": "vehicle_mass",
      "op": "<=",
      "value": "63",
      "unit": "kg",
      "clause": "6.1.3",
      "clause_status": "verified",
      "source": "openstd_fulltext_2024",
      "status": "verified",
      "verified_on": "2026-10-14",
      "applies_if": {"param": "battery_type", "op": "==", "value": "lead_acid"},
      "clause_excerpt": "使用铅酸蓄电池的装配完整的电动自行车整车质量应小于或等于 63 kg。",
      "notes": "仅适用铅酸蓄电池车型；其他类型由 vehicle_mass-other（同为 6.1.3）约束。条款号与数值以正式标准全文核对。"
    },
    {
      "standard": "GB17761-2024",
      "id": "GB17761-2024-vehicle_mass-other",
      "param": "vehicle_mass",
      "op": "<=",
      "value": "55",
      "unit": "kg",
      "clause": "6.1.3",
      "clause_status": "verified",
      "source": "openstd_fulltext_2024",
      "status": "verified",
      "verified_on": "2026-10-14",
      "applies_if": {"not": {"param": "battery_type", "op": "==", "value": "lead_acid"}},
      "clause_excerpt": "其他类型的装配完整的电动自行车的整车质量应小于或等于 55 kg。",
      "notes": "M1 已以正式标准全文 6.1.3 补齐：非铅蓄电池车型沿用 55 kg（前版存疑项已闭环，不再依赖推断）。"
    },
    {
      "standard": "GB17761-2024",
      "id": "GB17761-2024-plastic_mass_ratio",
      "param": "plastic_mass_ratio",
      "op": "<=",
      "value": "5.5",
      "unit": "%",
      "clause": "6.5.1",
      "clause_status": "verified",
      "source": "openstd_fulltext_2024",
      "status": "verified",
      "verified_on": "2026-10-14",
      "clause_excerpt": "电动自行车使用的塑料的总质量不应超过整车质量的 5.5%。",
      "notes": "新增要求；条款号以正式标准全文 6.5.1 塑料占比要求核对。"
    },
    {
      "standard": "GB17761-2024",
      "id": "GB17761-2024-nominal_voltage",
      "param": "nominal_voltage",
      "op": "<=",
      "value": "48",
      "unit": "V",
      "clause": "6.3.5",
      "clause_status": "verified",
      "source": "openstd_fulltext_2024",
      "status": "verified",
      "verified_on": "2026-10-14",
      "clause_excerpt": "电动自行车的电池组标示的标称电压通常可选择为 24 V、36 V 或 48 V，标示值不应超过 48 V。",
      "notes": "M1 已以正式标准全文 6.3.5 补齐（官方问答未列明该数值，此前为 pending）。"
    },
    {
      "standard": "GB17761-2024",
      "id": "GB17761-2024-motor_rated_power",
      "param": "motor_rated_power",
      "op": "<=",
      "value": "400",
      "unit": "W",
      "clause": "6.3.3.1",
      "clause_status": "verified",
      "source": "openstd_fulltext_2024",
      "status": "verified",
      "verified_on": "2026-10-14",
      "clause_excerpt": "测量此时电动机的输出功率，应小于或等于 400 W。",
      "notes": "M1 已以正式标准全文 6.3.3.1 电动机额定连续输出功率补齐（此前为 pending）。"
    },
    {
      "standard": "GB17761-2024",
      "id": "GB17761-2024-anti_tamper-battery",
      "param": "anti_tamper_battery_pack",
      "op": "==",
      "value": "true",
      "unit": "",
      "clause": "6.8.1.1",
      "clause_status": "verified",
      "source": "openstd_fulltext_2024",
      "status": "verified",
      "verified_on": "2026-10-14",
      "clause_excerpt": "电动自行车不应预留扩展车载电池的接口或线路；不应有外设电池组托架。",
      "notes": "防篡改三方面之一；布尔参数（设计满足为 true）；条款号以正式标准全文 6.8.1.1 核对。"
    },
    {
      "standard": "GB17761-2024",
      "id": "GB17761-2024-anti_tamper-controller",
      "param": "anti_tamper_controller",
      "op": "==",
      "value": "true",
      "unit": "",
      "clause": "6.8.2.1",
      "clause_status": "verified",
      "source": "openstd_fulltext_2024",
      "status": "verified",
      "verified_on": "2026-10-14",
      "clause_excerpt": "不应设计为通过剪线、跳线等方式进行修改；不应兼容多种电压模式。",
      "notes": "防篡改三方面之一；条款号以正式标准全文 6.8.2.1 核对。"
    },
    {
      "standard": "GB17761-2024",
      "id": "GB17761-2024-anti_tamper-speed_limiter",
      "param": "anti_tamper_speed_limiter",
      "op": "==",
      "value": "true",
      "unit": "",
      "clause": "6.8.3",
      "clause_status": "verified",
      "source": "openstd_fulltext_2024",
      "status": "verified",
      "verified_on": "2026-10-14",
      "clause_excerpt": "电动自行车应具备限速器防篡改功能。",
      "notes": "防篡改三方面之一；条款号以正式标准全文 6.8.3 核对。"
    },

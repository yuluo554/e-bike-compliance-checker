  "rules": [
    {
      "id": "GB17761-2024-max_design_speed",
      "param": "max_design_speed",
      "op": "<=",
      "value": "25",
      "unit": "km/h",
      "clause": "6.1.1.1",
      "clause_status": "verified",
      "source": {
        "kind": "standard_text",
        "url": "https://openstd.samr.gov.cn/bzgk/std/showGb?type=online&hcno=32E5D633E04B67FB241D100CA2A4A41D",
        "retrieved_on": "2026-10-14",
        "title": "国家标准全文公开系统 GB 17761—2024《电动自行车安全技术规范》全文（在线预览页图，共 43 页）",
        "issuer": "国家市场监督管理总局、国家标准化管理委员会"
      },
      "status": "verified",
      "verified_on": "2026-10-14",
      "clause_excerpt": "使用电驱动功能行驶时，最高车速不应超过最高设计车速，且最高设计车速不应超过 25 km/h。",
      "notes": "条款号与数值均以正式标准全文（6.1.1.1 车速限值要求 a)）逐条核对；数值与 gov.cn 官方问答一致。"
    },
    {
      "id": "GB17761-2024-over_speed_power_cutoff",
      "param": "over_speed_power_cutoff",
      "op": "==",
      "value": "true",
      "unit": "",
      "clause": "6.1.1.1",
      "clause_status": "verified",
      "source": {
        "kind": "standard_text",
        "url": "https://openstd.samr.gov.cn/bzgk/std/showGb?type=online&hcno=32E5D633E04B67FB241D100CA2A4A41D",
        "retrieved_on": "2026-10-14",
        "title": "国家标准全文公开系统 GB 17761—2024《电动自行车安全技术规范》全文（在线预览页图，共 43 页）",
        "issuer": "国家市场监督管理总局、国家标准化管理委员会"
      },
      "status": "verified",
      "verified_on": "2026-10-14",
      "clause_excerpt": "如果车速超过 25 km/h，电动机不应提供动力输出。",
      "notes": "布尔参数承载（具备该功能为 true）；条款号以正式标准全文 6.1.1.1 a)/b) 核对。"
    },
    {
      "id": "GB17761-2024-vehicle_mass-lead-acid",
      "param": "vehicle_mass",
      "op": "<=",
      "value": "63",
      "unit": "kg",
      "clause": "6.1.3",
      "clause_status": "verified",
      "applies_if": {
        "param": "battery_type",
        "op": "==",
        "value": "lead_acid"
      },
      "source": {
        "kind": "standard_text",
        "url": "https://openstd.samr.gov.cn/bzgk/std/showGb?type=online&hcno=32E5D633E04B67FB241D100CA2A4A41D",
        "retrieved_on": "2026-10-14",
        "title": "国家标准全文公开系统 GB 17761—2024《电动自行车安全技术规范》全文（在线预览页图，共 43 页）",
        "issuer": "国家市场监督管理总局、国家标准化管理委员会"
      },
      "status": "verified",
      "verified_on": "2026-10-14",
      "clause_excerpt": "使用铅酸蓄电池的装配完整的电动自行车整车质量应小于或等于 63 kg。",
      "notes": "仅适用铅酸蓄电池车型；其他类型由 vehicle_mass-other（同为 6.1.3）约束。条款号与数值以正式标准全文核对。"
    },
    {
      "id": "GB17761-2024-vehicle_mass-other",
      "param": "vehicle_mass",
      "op": "<=",
      "value": "55",
      "unit": "kg",
      "clause": "6.1.3",
      "clause_status": "verified",
      "applies_if": {
        "not": {
          "param": "battery_type",
          "op": "==",
          "value": "lead_acid"
        }
      },
      "source": {
        "kind": "standard_text",
        "url": "https://openstd.samr.gov.cn/bzgk/std/showGb?type=online&hcno=32E5D633E04B67FB241D100CA2A4A41D",
        "retrieved_on": "2026-10-14",
        "title": "国家标准全文公开系统 GB 17761—2024《电动自行车安全技术规范》全文（在线预览页图，共 43 页）",
        "issuer": "国家市场监督管理总局、国家标准化管理委员会"
      },
      "status": "verified",
      "verified_on": "2026-10-14",
      "clause_excerpt": "其他类型的装配完整的电动自行车的整车质量应小于或等于 55 kg。",
      "notes": "M1 已以正式标准全文 6.1.3 补齐：非铅蓄电池车型沿用 55 kg（前版存疑项已闭环，不再依赖推断）。"
    },

      },
      "status": "verified",
      "verified_on": "2026-10-14",
      "clause_excerpt": "电动自行车使用的塑料的总质量不应超过整车质量的 5.5%。",
      "notes": "新增要求；条款号以正式标准全文 6.5.1 塑料占比要求核对。"
    },
